NODE_ENV=development
API_PORT=8787
APP_ORIGIN=http://127.0.0.1:5173

# Supply a PostgreSQL connection URI locally. Keep this blank for preview-only mode.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_CA_CERT_PATH=

# Add rotated BotFather credentials only to the ignored local .env file.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600

# Rewards stay disabled until policy and verification are approved.
DAILY_CHECKIN_ENABLED=false
DAILY_CHECKIN_POINTS=50
TASK_URL_X_FOLLOW=
TASK_URL_TELEGRAM_CHANNEL=
TASK_URL_DISCORD=
TASK_URL_FACEBOOK=
TASK_URL_INSTAGRAM=
TASK_URL_YOUTUBE=
TASK_URL_X_POST=
PUBLIC_URL_X=
PUBLIC_URL_TELEGRAM=
PUBLIC_URL_ANNOUNCEMENTS=
PUBLIC_URL_WEBSITE=

# Provider rewards and financial features are intentionally disabled.
ADSGRAM_ENABLED=false
# ADSGRAM_BLOCK_ID=
# ADSGRAM_SERVER_POSTBACK_SECRET=
WALLET_CHAIN=unconfigured
WALLET_NETWORK=unconfigured
PAYOUTS_ENABLED=false
REVENUE_SHARE_ENABLED=false
SHARE_REWARD_ENABLED=false
